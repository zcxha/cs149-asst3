{
  "version": 4,
  "configurations": [
    {
      "name": "Linux",
      "compilerPath": "/usr/bin/g++",
      "compilerArgs": [
        "-I${workspaceFolder}/cuda_headers"
      ],
      "intelliSenseMode": "linux-gcc-x64",
      "cppStandard": "c++17",
      "includePath": [
        "${workspaceFolder}",
        "${workspaceFolder}/scan",
        "${workspaceFolder}/cuda_headers",
        "${workspaceFolder}/cuda_headers/**"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}",
          "${workspaceFolder}/scan",
          "${workspaceFolder}/cuda_headers"
        ]
      },
      "defines": [
        "__CUDACC__"
      ]
    }
  ]
}
